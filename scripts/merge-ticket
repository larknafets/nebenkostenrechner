#!/usr/bin/env bash
# Merges a finished ticket branch into the current integration branch and runs
# the checks: `scripts/merge-ticket ticket/291`. It stops at a conflict (resolve
# it, `git commit`, then `scripts/check`) and at a red check. It never touches
# `main`: run it on the integration branch (docs/agents/agents.md).
set -euo pipefail
cd "$(dirname "$0")/.."

branch=${1:?usage: scripts/merge-ticket <branch>}
current=$(git branch --show-current)
if [ "$current" = main ]; then
  echo "merge-ticket: on main, switch to the integration branch first" >&2
  exit 1
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "merge-ticket: the working tree is not clean" >&2
  exit 1
fi

git merge --no-edit "$branch"
scripts/check
printf '\nmerge-ticket: %s merged into %s, checks green\n' "$branch" "$current"
