#!/usr/bin/env bash
# Runs the same checks as the CI job `test` (.github/workflows/ci.yml), so a
# red build shows up before the push. `scripts/check --vuln` adds govulncheck,
# which CI only runs nightly.
set -euo pipefail
cd "$(dirname "$0")/.."

step() { printf '\n==> %s\n' "$1"; }

step "gofmt"
unformatted=$(git ls-files -z '*.go' | xargs -0 gofmt -l)
if [ -n "$unformatted" ]; then
  echo "Not gofmt-formatted:"
  echo "$unformatted"
  exit 1
fi

step "em dash"
dashes=$(git grep -lI $'\xe2\x80\x94' || true)
if [ -n "$dashes" ]; then
  echo "Em dash (U+2014) in committed files, use a comma, a colon or ' - ':"
  echo "$dashes"
  exit 1
fi

step "conflict markers"
# A merge that was resolved halfway leaves the marker lines in a file, and a
# green build does not notice them in Markdown or a template. The script names
# the markers itself, so it is the one exception.
markers=$(git grep -nIE '^(<<<<<<<|>>>>>>>) ' -- . ':!scripts/check' || true)
if [ -n "$markers" ]; then
  echo "Merge conflict markers in committed files, resolve the conflict:"
  echo "$markers"
  exit 1
fi

step "stray copies"
# A sync tool or Finder leaves "file 2.go" next to "file.go". They are not
# ignored on purpose: this step has to see them, and a `git add -A` would
# commit them.
strays=$(git ls-files -co --exclude-standard | grep -E ' [0-9]+(\.[^/]*)?$' || true)
if [ -n "$strays" ]; then
  echo "Copies with a number suffix in the working tree, delete them (compare with the original first):"
  echo "$strays"
  exit 1
fi

# BSD `sed -i` without an empty suffix argument leaves "file.go-E", a merge or
# patch leaves ".orig" or ".rej". A tracked one stays in the repository.
leftovers=$(git ls-files | grep -E '(-E|\.orig|\.rej)$' || true)
if [ -n "$leftovers" ]; then
  echo "Tracked leftovers of sed, merge or patch, delete them:"
  echo "$leftovers"
  exit 1
fi

step "go vet"
go vet ./...

step "golangci-lint"
if command -v golangci-lint >/dev/null; then
  ci_lint=$(sed -n 's/^ *version: v\(2\.[0-9.]*\)$/\1/p' .github/workflows/ci.yml)
  local_lint=$(golangci-lint --version | sed -n 's/.*has version \([0-9.]*\).*/\1/p')
  if [ -n "$ci_lint" ] && [ "$ci_lint" != "$local_lint" ]; then
    echo "warning: golangci-lint $local_lint here, CI pins $ci_lint (.github/workflows/ci.yml): CI may report what this run does not" >&2
  fi
  golangci-lint run
else
  echo "golangci-lint not installed (brew install golangci-lint): CI runs it, so this check is incomplete" >&2
  exit 1
fi

step "actionlint"
if command -v actionlint >/dev/null; then
  actionlint
else
  echo "actionlint not installed (brew install actionlint): a broken workflow would only show up on main" >&2
  exit 1
fi

step "go test"
go test ./...

step "go build"
go build ./...

if [ "${1:-}" = "--vuln" ]; then
  step "govulncheck"
  if command -v govulncheck >/dev/null; then
    govulncheck ./...
  else
    go run golang.org/x/vuln/cmd/govulncheck@latest ./...
  fi
fi

printf '\nAll checks passed.\n'
