#!/usr/bin/env bash
# Blocks a push while the CI checks would fail. Enable once per clone:
#   git config core.hooksPath .githooks
# Skip in an emergency with the --no-verify flag of the push.
#
# Git passes one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>.
# A push that only deletes branches or tags sends nothing, so nothing is checked.
zero=0000000000000000000000000000000000000000
refs=0
uploads=0
while read -r _ local_sha _ _; do
  refs=$((refs + 1))
  [ "$local_sha" != "$zero" ] && uploads=$((uploads + 1))
done

if [ "$refs" -gt 0 ] && [ "$uploads" -eq 0 ]; then
  echo "pre-push: only deletions, no checks"
  exit 0
fi

exec "$(git rev-parse --show-toplevel)/scripts/check"
