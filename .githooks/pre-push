#!/usr/bin/env bash
# Blocks a push while the CI checks would fail. Enable once per clone:
#   git config core.hooksPath .githooks
# Skip in an emergency with the --no-verify flag of the push.
#
# Git passes one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>.
# A push that only deletes branches or tags sends nothing, so nothing is checked.
zero=0000000000000000000000000000000000000000
root=$(git rev-parse --show-toplevel)
refs=0
uploads=0
while read -r _ local_sha remote_ref remote_sha; do
  refs=$((refs + 1))
  [ "$local_sha" = "$zero" ] && continue
  uploads=$((uploads + 1))
  # Every pushed commit and tag must carry a signature (docs/agents/git-workflow.md).
  # Only the header is checked, so no allowed_signers file is needed.
  case "$remote_ref" in
    refs/tags/*)
      git cat-file tag "$local_sha" 2>/dev/null | grep -q 'BEGIN SSH SIGNATURE' \
        || { echo "pre-push: $remote_ref is not a signed tag (git tag -s)" >&2; exit 1; }
      ;;
    *)
      if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        range="$remote_sha..$local_sha"
      else
        range="$local_sha --not --remotes"
      fi
      # shellcheck disable=SC2086 # range is two words on purpose
      for c in $(git rev-list $range); do
        git cat-file commit "$c" | sed '/^$/q' | grep -q '^gpgsig ' \
          || { echo "pre-push: commit $(git rev-parse --short "$c") is not signed" >&2; exit 1; }
      done
      ;;
  esac
  # Go version, Dockerfile and workflows never go straight to main.
  if [ "$remote_ref" = "refs/heads/main" ] && [ "$remote_sha" != "$zero" ] \
    && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    "$root/scripts/pr-only-paths" "$remote_sha" "$local_sha" || exit 1
  fi
done

if [ "$refs" -gt 0 ] && [ "$uploads" -eq 0 ]; then
  echo "pre-push: only deletions, no checks"
  exit 0
fi

exec "$root/scripts/check"
