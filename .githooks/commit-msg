#!/usr/bin/env bash
# Checks the commit message against docs/agents/git-commit-messages.md: subject
# format, length and no em dash. Enable once per clone:
#   git config core.hooksPath .githooks
# Skip in an emergency with the --no-verify flag of the commit.
set -euo pipefail

msg_file="$1"
# Drop the comment lines git adds to the editor template.
message=$(grep -v '^#' "$msg_file" || true)
subject=$(printf '%s\n' "$message" | sed -n '1p')

# Merge, revert, fixup and squash subjects are generated by git, not written.
case "$subject" in
  "Merge "* | 'Revert "'* | "fixup! "* | "squash! "*) exit 0 ;;
esac

fail() {
  echo "commit-msg: $1" >&2
  echo "  subject: $subject" >&2
  echo "  rules: docs/agents/git-commit-messages.md" >&2
  exit 1
}

types='feat|fix|refactor|perf|docs|test|style|chore|ci|build|revert'
if ! printf '%s\n' "$subject" | grep -qE "^($types)(\([a-z0-9#-]+\))?!?: ."; then
  fail "subject must look like <type>(<scope>): <summary>, type one of ${types//|/, }, scope lower case"
fi

length=$(printf '%s' "$subject" | wc -m | tr -d ' ')
if [ "$length" -gt 72 ]; then
  fail "subject has $length characters, the hard cap is 72"
fi

if printf '%s\n' "$message" | grep -q $'\xe2\x80\x94'; then
  fail "message contains an em dash, use a comma, a colon or ' - '"
fi

# Umlaute are written as ä, ö, ü, ß, never as ae, oe, ue, ss. A general pattern
# would hit "neue" or "Queue", so this is a list of the common stems.
ascii_stems='aender|aendr|ergaenz|unveraender|entfaell|laed[te]|ueber|fuer|ausfuehr|hinzufuegen|zufuegen|pruef|rueck|oeffn|loesch|waehl|zaehl|groess|moeglich|noetig|koennen|muessen|waere|haette|eintraeg|betraeg|verlaeuf|faelle|fuehr|beruehr|spaet|fruehe'
if hit=$(printf '%s\n' "$message" | grep -iEo "\\b[a-z]*($ascii_stems)[a-z]*" | head -3 | tr '\n' ' ') && [ -n "$hit" ]; then
  fail "message spells Umlaute as ae, oe, ue (${hit% }), write ä, ö, ü, ß"
fi
